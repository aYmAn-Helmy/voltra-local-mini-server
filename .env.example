# Required for real/LAN mode. Use a long random value.
VOLTRA_API_TOKEN=replace-with-a-long-random-token

# Host ports exposed by Docker.
VOLTRA_HTTP_PORT_HOST=8086
VOLTRA_TCP_PORT_HOST=10086

# Same-origin dashboard does not need CORS. Keep * only for initial LAN testing.
VOLTRA_CORS_ORIGIN=*

# Optional tuning.
VOLTRA_POLL_INTERVAL=10
VOLTRA_DIAGNOSTICS_INTERVAL=30
VOLTRA_TELEMETRY_INTERVAL=60
VOLTRA_COMMAND_ATTEMPTS=2
VOLTRA_COMMAND_CONFIRM_DELAY=0.15
VOLTRA_RATE_LIMIT_PER_MINUTE=120
