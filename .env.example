# Host ports exposed by Docker.
VOLTRA_HTTP_PORT_HOST=8086
VOLTRA_TCP_PORT_HOST=10086

# Secure remote access. Generate VOLTRA_API_TOKEN with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave VOLTRA_API_TOKEN empty only for trusted LAN-only deployments.
VOLTRA_API_TOKEN=
VOLTRA_TRUSTED_PROXY=192.168.1.7/32
VOLTRA_PUBLIC_ORIGIN=https://b8710ce04869.sn.mynetname.net:8443

# Same-origin dashboard does not need CORS. For the public deployment use the exact HTTPS origin,
# including a non-default external port when one is used.
VOLTRA_CORS_ORIGIN=https://b8710ce04869.sn.mynetname.net:8443

# Optional tuning.
VOLTRA_POLL_INTERVAL=10
VOLTRA_DIAGNOSTICS_INTERVAL=30
VOLTRA_TELEMETRY_INTERVAL=60
VOLTRA_COMMAND_ATTEMPTS=2
VOLTRA_COMMAND_CONFIRM_DELAY=0.15
VOLTRA_RATE_LIMIT_PER_MINUTE=120

VOLTRA_DISCOVERY_PORT_HOST=10087
VOLTRA_TIMEZONE=Africa/Cairo
