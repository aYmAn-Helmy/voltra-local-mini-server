# Miqaat: trusted-LAN deployment with no API token.
# Access from a phone/PC on the SAME private LAN, never the public internet.
# Any router port-forward or HTTPS reverse proxy for Voltra must be disabled.
VOLTRA_HTTP_PORT_HOST=8086
VOLTRA_TCP_PORT_HOST=10086
VOLTRA_DISCOVERY_PORT_HOST=10087
VOLTRA_TIMEZONE=Africa/Cairo
VOLTRA_POLL_INTERVAL=10
VOLTRA_DIAGNOSTICS_INTERVAL=30
VOLTRA_TELEMETRY_INTERVAL=60
VOLTRA_COMMAND_ATTEMPTS=2
VOLTRA_COMMAND_CONFIRM_DELAY=0.15
VOLTRA_RATE_LIMIT_PER_MINUTE=120

# Optional Home Assistant MQTT bridge (disabled when blank)
VOLTRA_MQTT_HOST=
VOLTRA_MQTT_PORT=1883
VOLTRA_MQTT_USERNAME=
VOLTRA_MQTT_PASSWORD=
VOLTRA_MQTT_TLS=0
